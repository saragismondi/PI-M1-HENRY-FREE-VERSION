# Copiá este archivo como .env y completá tus claves. El archivo .env NO se sube a GitHub.
# Versión gratuita: solo proveedores con plan gratis (Groq y NVIDIA). Anthropic no se usa.

# --- Claves ---
# Groq: console.groq.com -> API Keys (plan gratuito con límites diarios: 200.000 tokens por día por modelo)
GROQ_API_KEY=tu_clave_groq
# NVIDIA: build.nvidia.com -> elegir un modelo -> "Get API Key" (acceso gratis del Developer Program).
# Límite reportado por usuarios en el foro de NVIDIA: ~40 llamadas por minuto (no hay número oficial).
NVIDIA_API_KEY=tu_clave_nvidia

# --- Modelos ---
# Verificá que el nombre exista en la documentación oficial de cada proveedor.
GROQ_MODEL=openai/gpt-oss-120b
# IDs confirmados con la API de NVIDIA (fase 1 del plan, 07/11/2026):
#   nvidia/nemotron-3.5-bolt-e4b       (fase 1: único de 6 que respetó el contrato; 302 tokens, 3,85 s)
#   mistralai/mistral-large-4-1t-a52b  (fase 1: el razonamiento se comió los 500 tokens)
#   openai/gpt-oss-20b                 (fase 1: timeout a los 30 s)
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# --- Parámetros de la llamada ---
# Tope de tokens de salida. El JSON de respuesta midió ~200 tokens en la primera prueba real.
MAX_TOKENS=500
# 0 = respuestas más estables.
TEMPERATURE=0
# Razonamiento interno: sus tokens cuentan dentro de MAX_TOKENS y cortaban el JSON.
# Groq y NVIDIA: low | medium | high. Vacío = no se manda (no todos los modelos lo aceptan).
# El ejemplo oficial de Mistral Large 4 usa "high": NO, porque el razonamiento consume MAX_TOKENS y corta el JSON.
GROQ_REASONING_EFFORT=low
NVIDIA_REASONING_EFFORT=low
# Salida estructurada: json_schema | json_object | off
GROQ_STRUCTURED=json_schema
NVIDIA_STRUCTURED=json_schema

# --- Moderador LLM (segunda capa de guardrails): off | output | both ---
# both = modera el ticket y la respuesta (hasta 2 llamadas extra por consulta).
MODERATION=both
# Puntaje (0 a 1) desde el cual el moderador marca un riesgo.
MODERATION_THRESHOLD=0.5
# Proveedor del moderador: groq | nvidia. En el proyecto base, con el moderador en Groq se agotó el
# cupo diario de Groq; por eso modera NVIDIA (sin verificar todavía: fase 4 del plan).
MODERATOR_PROVIDER=nvidia

# --- Proveedor por defecto: groq | nvidia ---
DEFAULT_PROVIDER=groq
