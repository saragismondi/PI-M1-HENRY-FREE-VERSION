# Copiá este archivo como .env y completá tus claves. El archivo .env NO se sube a GitHub.

# --- Claves (obligatorias según el proveedor que uses) ---
# Anthropic: console.anthropic.com -> API Keys (requiere créditos prepagos)
ANTHROPIC_API_KEY=tu_clave_anthropic
# Groq: console.groq.com -> API Keys (tiene plan gratuito con límites de uso)
GROQ_API_KEY=tu_clave_groq

# --- Modelos ---
# Verificá que el nombre exista en la documentación oficial de cada proveedor.
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_MODEL=openai/gpt-oss-120b

# --- Parámetros de la llamada ---
# Tope de tokens de salida. El JSON de respuesta midió ~200 tokens en la primera prueba real.
MAX_TOKENS=500
# Solo aplica a Groq (anthropic 2.6.0 no acepta temperature). 0 = respuestas más estables.
TEMPERATURE=0
# Razonamiento interno: sus tokens cuentan dentro de MAX_TOKENS y cortaban el JSON.
# Anthropic: disabled | adaptive.  Groq: low | medium | high.
ANTHROPIC_THINKING=disabled
GROQ_REASONING_EFFORT=low

# --- Moderador LLM (segunda capa de guardrails): off | output | both ---
# both = modera el ticket y la respuesta (hasta 2 llamadas extra por consulta).
MODERATION=both
# Puntaje (0 a 1) desde el cual el moderador marca un riesgo.
MODERATION_THRESHOLD=0.5
# Proveedor del moderador (anthropic | groq). Haiku no consume el cupo diario gratis de Groq.
MODERATOR_PROVIDER=anthropic

# --- Proveedor por defecto: anthropic | groq ---
DEFAULT_PROVIDER=groq
